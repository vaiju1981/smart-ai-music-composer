# --- Project-specific ---

# Internal scratch / log directory — not part of the product
.remember/

# FFmpeg source tree + build outputs (rebuildable from scripts/build_ffmpeg.sh)
vendor/ffmpeg/
vendor/ffmpeg-build/

# Valkey data dir (local dev only)
var/valkey/

# Job worker runtime data (artifacts, logs) — regenerated on every run
var/jobs/
var/rq/

# Downloaded / cached assets — re-downloaded from documented sources
assets/salamander/
assets/bravura/
assets/*.sf2
assets/soundfonts/*.sf2
var/tmp/

# Downloaded models (Ollama + others)
assets/models/

# Build / packaging artefacts
*.dmg
*.pkg
*.AppImage
*.deb
*.rpm
dist-build/

# Environment files (NEVER commit API keys)
.env
.env.local
.env.*.local
*.env

# Secrets that may have ended up on disk
secrets/
*.pem
*.key

# OS scratch
*.log
logs/